# Copy to .env and fill in. Never commit .env.

# --- Required ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# --- Database (default: the compose "mongo" service) ---
# MONGO_URI=mongodb://mongo:27017/teamnova

# Public URL of the web app (CORS + links in emails)
CLIENT_URL=http://localhost:8080

# --- Email alerts / verification (optional) ---
EMAIL_SERVICE=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_COOLDOWN_MINUTES=30

# --- Alerts / watchdog (optional) ---
SMS_COOLDOWN_MINUTES=30
# WATCHDOG_CHECK_INTERVAL_MS=60000

# --- Compose settings ---
WEB_PORT=8080
# IMAGE_PREFIX=ghcr.io/<your-org>/team-nova
# IMAGE_TAG=local
